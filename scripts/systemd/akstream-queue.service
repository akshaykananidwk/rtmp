[Unit]
Description=AK Computer queue worker
After=network.target mysql.service redis.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/akstream/current
ExecStart=/var/www/akstream/current/scripts/run-artisan.sh /usr/bin/php /var/www/akstream/current queue:work --sleep=2 --tries=3 --max-time=3600 --timeout=3600
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
