[Unit]
Description=AK Computer stream supervisor (FFmpeg relays + recording)
After=network.target mediamtx.service mysql.service redis.service
Wants=mediamtx.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/akstream/current
ExecStart=/var/www/akstream/current/scripts/run-artisan.sh /usr/bin/php /var/www/akstream/current stream:supervisor --interval=2
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
