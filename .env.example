# ---------------------------------------------------------------
#  AK COMPUTER – ONE LIVE EVERYWHERE
#  Copy this file to .env (the installer at /install does it for you)
#  NEVER commit .env to version control.
# ---------------------------------------------------------------
APP_NAME="AK COMPUTER – ONE LIVE EVERYWHERE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://stream.example.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ak_stream
DB_USERNAME=ak_stream
DB_PASSWORD=

# The installer switches these to database drivers once the DB is configured.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Redis (recommended on VPS; optional on shared hosting)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Streaming engine (MediaMTX) ---------------------------------
# Public RTMP ingest URL shown to users (OBS "Server")
STREAM_SERVER_URL=rtmp://stream.example.com/live
# MediaMTX control API (keep private, bind to localhost)
STREAM_SERVER_API_URL=http://127.0.0.1:9997
# Internal RTMP URL that FFmpeg relays pull from (same host as MediaMTX)
STREAM_INTERNAL_RTMP_URL=rtmp://127.0.0.1:1935/live
STREAM_HLS_URL=http://127.0.0.1:8888
# Shared secret used by MediaMTX hooks (runOnReady / authHTTP) to call back into the app
STREAM_ENGINE_SECRET=
STREAM_NODE_ID=media-1
FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
STREAM_AUTO_DISTRIBUTION=false
STREAM_MAX_RETRIES=5

# --- Recording ----------------------------------------------------
RECORDING_DISK=local
RECORDING_PATH=recordings
RECORDING_RETENTION_DAYS=30

# --- GitHub auto-update (can also be configured in the admin UI) --
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_TOKEN=
UPDATE_RELEASES_PATH=
UPDATE_STRATEGY=auto

# --- Platform OAuth apps -----------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Storage ------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Optional WhatsApp notifications (Meta Cloud API) -------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=
